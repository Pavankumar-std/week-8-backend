              },
              {
                "key": "Authorization",
                "value": "Bearer abc.invalid.token"
              }
            ],
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Wrong role (candidate creates job)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{candidateToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/jobs",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"React Intern\",\n  \"company\": \"DG Tech\",\n  \"description\": \"Build UI with React\",\n  \"location\": \"Remote\",\n  \"type\": \"internship\",\n  \"skills\": [\n    \"react\",\n    \"javascript\"\n  ],\n  \"deadline\": \"2026-12-31\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
