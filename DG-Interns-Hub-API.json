              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{recruiterToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/jobs/{{jobId}}"
          },
          "event": [
